<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent template for the elastic-llm-benchmarker daemon (24/7-autonomy P0:
  daemon supervision / auto-restart).

  Do NOT edit this template with real paths and commit it. Run
  scripts/install-launchd.sh, which renders the __PLACEHOLDER__ tokens from the
  current checkout into ~/Library/LaunchAgents/com.elastic-llm-benchmarker.plist
  (gitignored location) and loads it.

  KeepAlive + RunAtLoad give crash-restart and boot-start. Recovery is safe: on
  restart the daemon reclaims stale in-flight entries (reclaimStaleEntries) and
  resumes/adopts the current run, so KeepAlive never double-processes a model.

  KeepAlive is unconditional (not `{SuccessfulExit: false}`): the daemon's own
  SIGTERM handler (src/cli/start-handler.ts `shutdown()`) always exits 0 after
  a clean gracefulShutdown() -- that is the *normal* stop path (operator
  `benchmarker-queue stop`, `launchctl kickstart -k`, a deploy bounce), not a
  failure, and it must respawn too. A restart-on-crash-only policy left the
  daemon permanently dead after every clean stop until a human noticed and
  restarted it by hand.
  This is safe to make unconditional: every startup/config-error path in
  src/cli.ts and start-handler.ts (bad config, held lockfile, missing ES
  client, ...) throws CliError and exits 1, never 0 -- so KeepAlive can't be
  tricked into a 30s-throttled restart loop by a persistent misconfiguration.
  gracefulShutdown() itself is bounded by shutdownDrainTimeoutMs (default 5m,
  see scheduler.ts SchedulerOptions), so a hung in-flight drain still resolves
  and calls process.exit(0) within 5 minutes -- it cannot wedge forever and
  starve KeepAlive of the exit it needs to act on.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.elastic-llm-benchmarker</string>

  <!--
    run-daemon.sh restores the nvm-managed node on PATH (launchd starts with a
    bare environment and no login shell, so cli.js's `#!/usr/bin/env node`
    shebang would otherwise fail to resolve), then execs start-local.sh.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>exec __REPO_ROOT__/scripts/run-daemon.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- Do not thrash-restart: wait 30s between respawns. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/.smoke-logs/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/.smoke-logs/daemon.log</string>

  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
